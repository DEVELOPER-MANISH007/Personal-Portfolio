# Copy this file to .env and fill in your own EmailJS credentials.
# Create a free account at https://www.emailjs.com/, add an email
# service + template, then paste the IDs below. The contact form
# degrades gracefully (shows a clear error + fallback email link)
# if these are left unset.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
